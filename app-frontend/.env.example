VITE_GOOGLE_CLIENT_ID=
# VITE_FACEBOOK_APP_ID=
# VITE_GITHUB_CLIENT_ID=

# Full OAuth authorization URLs used by the social login buttons. When unset,
# the corresponding button is hidden.
#   Google: implicit flow — must include response_type=token
#   GitHub: authorization-code flow — response_type defaults to "code"
VITE_GOOGLE_LINK=
VITE_GITHUB_LINK=
